# Copy to .env and fill in. All keys are OPTIONAL: without them REILLY
# uses only free public sources (Google News RSS, GDELT, Wikipedia,
# Yahoo Finance, Binance, CoinGecko, World Bank, ECB).

# OpenRouter (LLM summary / query translation). https://openrouter.ai/keys
OPENROUTER_API_TOKEN=
# Optional: fixed model id. Empty = first free model from OpenRouter catalogue.
OPENROUTER_MODEL=

# Bright Data SERP API (paid). https://brightdata.com/cp/zones
BRIGHTDATA_API_TOKEN=
# Name of the SERP API zone, e.g. serp_api1
BRIGHTDATA_SERP_ZONE=

# Default interface / report language: en, uk, de, fr, es, it, pl
# (the menu option "Language" overrides it and remembers the choice)
REILLY_LANG=uk

# Contact shown in the User-Agent (good manners for public APIs)
REILLY_CONTACT=
